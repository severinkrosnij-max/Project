def f_task5(t):
    if 0 <= t <= 2 * math.pi:
        return math.sin(t - math.pi / 2) + 1
    else:
        return 0.0

N = 20
T_integration = 2 * math.pi

coefficients_f = []

print(f"Коефіцієнти перетворення Лагерра f_k для N = {N}:")
print("-" * 35)
print(f"{'k':<5} | {'f_k':<25}")
print("-" * 35)

for k in range(N + 1):
    f_k = transformation(
        k=k,
        T=T_integration,
        f=f_task5,
        steps=1000, 
        beta=2.0,
        sigma=4.0,
        epsilon=1e-4
    )
    coefficients_f.append(f_k)
    print(f"{k:<5} | {f_k:<25.10e}")


def inverse_laguerre_transform(h_seq, t, beta=2.0, sigma=4.0):
    result = 0.0
    for k in range(len(h_seq)):
        result += h_seq[k] * laguerre_func(t, k, beta, sigma)
    
    return result

t_test = math.pi

approx_val = inverse_laguerre_transform(coefficients_f, t_test)
exact_val = f_task5(t_test)

print(f"Тестування оберненого перетворення у точці t = {t_test:.5f}:")
print(f"Точне значення функції:      f(t)   = {exact_val:.5f}")
print(f"Наближене значення (оберн. ПЛ): h^N(t) = {approx_val:.5f}")
print(f"Абсолютна похибка:                   {abs(exact_val - approx_val):.5e}")


def plot_laguerre(N, T, step=0.1, beta=2.0, sigma=4.0):
    plt.figure(figsize=(10, 6))
    
    for n in range(N + 1):
        data = tabulate_laguerre(n, T, step, beta, sigma)
        
        t_vals = [pt[0] for pt in data]
        y_vals = [pt[1] for pt in data]
        
        plt.plot(t_vals, y_vals, label=f"l_{{{n}}}(t)")
    
    plt.title(f"Графіки функцій Лаґерра l_n(t) для n \\in [0, {N}] на [0, {T}]")
    plt.xlabel("t")
    plt.ylabel("l_n(t)")
    plt.grid(True)
    
    plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')
    plt.tight_layout()
    plt.show()
    
plot_laguerre(N=5, T=4.0, step=0.05)


def approximate_function(coeffs, N, t_vals, beta=2.0, sigma=4.0):

    h = coeffs[:N + 1]
    return [inverse_laguerre_transform(h, t, beta, sigma) for t in t_vals]


def plot_approximation(f, coeffs, N_list, T=2 * math.pi, points=300):
    t_vals = [i * T / points for i in range(points + 1)]
    exact = [f(t) for t in t_vals]

    plt.figure(figsize=(10, 6))
    plt.plot(t_vals, exact, "k--", linewidth=2, label="f(t) (точна)")

    print(f"{'N':<5} | {'max |f - f_N|':<15}")
    print("-" * 25)

    for N in N_list:
        approx = approximate_function(coeffs, N, t_vals)
        plt.plot(t_vals, approx, label=f"N = {N}")

        max_err = max(abs(e - a) for e, a in zip(exact, approx))
        print(f"{N:<5} | {max_err:<15.5e}")

    plt.title("Обернене перетворення Лаґерра для f(t) на [0, 2π]")
    plt.xlabel("t")
    plt.ylabel("f(t)")
    plt.grid(True)
    plt.legend(loc="upper right")
    plt.tight_layout()
    plt.show()


plot_approximation(f_task5, coefficients_f, N_list=[2, 5, 10, 20])



